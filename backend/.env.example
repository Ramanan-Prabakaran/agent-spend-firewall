# ── PayPal Sandbox Credentials ──────────────────────────────────────────────
# Obtain from: https://developer.paypal.com → Apps & Credentials → Sandbox
# IMPORTANT: Use credentials associated with a US-based sandbox Business account.
PAYPAL_CLIENT_ID=YOUR_PAYPAL_SANDBOX_CLIENT_ID
PAYPAL_CLIENT_SECRET=YOUR_PAYPAL_SANDBOX_CLIENT_SECRET

# ── Groq LLM API (OpenAI-compatible) ─────────────────────────────────────────
# Obtain from: https://console.groq.com/keys
# Used exclusively for transaction extraction and prompt-injection risk scoring.
GROQ_API_KEY=YOUR_GROQ_API_KEY
# Model name (default: openai/gpt-oss-120b)
GROQ_MODEL=openai/gpt-oss-120b

# ── Application Endpoints ───────────────────────────────────────────────────
PORT=3001
FRONTEND_URL=http://localhost:5173

# ── Deterministic Firewall Policy Knobs ──────────────────────────────────────
# The deterministic firewall evaluates these safety thresholds independently.
# LLMs NEVER make monetary or allow/block decisions.
SPEND_CEILING_USD=500
QTY_CEILING=10
PRICE_DEVIATION_MAX_PCT=30
INJECTION_SCORE_THRESHOLD=0.6
ALLOWED_SHIPPING_ADDRESSES=registered delivery address,default shipping address,corporate office,authorized warehouse,primary address
